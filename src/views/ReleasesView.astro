---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageIntro from "../components/layout/PageIntro.astro";
import ReleaseList from "../components/product/ReleaseList.astro";
import ArrowUpRight from "@lucide/astro/icons/arrow-up-right";
import { useDict, type Locale } from "../i18n";
import { REPO_URL } from "../config/site";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const all = useDict(locale);
const t = all.releases;
---

<BaseLayout locale={locale} title={t.title} description={t.description}>
  <PageIntro eyebrow={t.eyebrow} title={t.heading} />
  <section class="section pt-12 sm:pt-16">
    <div class="container-site max-w-4xl">
      <ReleaseList locale={locale} />
      <section aria-labelledby="channels" class="mt-16">
        <h2 id="channels" class="t-3">
          {t.channels}
        </h2>
        <dl class="mt-6 grid gap-8 sm:grid-cols-2">
          {t.channelItems.map((c) => (
            <div class="border-t border-line-strong pt-5">
              <dt class="font-semibold">{c.title}</dt>
              <dd class="mt-2 text-muted">{c.body}</dd>
            </div>
          ))}
        </dl>
        <a href={REPO_URL} target="_blank" rel="noopener" class="link mt-10 inline-flex items-center gap-1.5 font-medium">
          {t.github}
          <ArrowUpRight size={16} aria-hidden="true" />
          <span class="sr-only">{all.a11y.newTab}</span>
        </a>
      </section>
    </div>
  </section>
</BaseLayout>
<script>
  import "../lib/client/downloads";
</script>
