---
import ArrowUpRight from "@lucide/astro/icons/arrow-up-right";
import CircleDashed from "@lucide/astro/icons/circle-dashed";
import { useDict, formatDate, type Locale } from "../../i18n";
import { sortReleases, type Release } from "../../lib/releases";

interface Props {
  locale: Locale;
  releases: Release[];
}
const { locale, releases } = Astro.props;
const all = useDict(locale);
const t = all.releases;
const list = sortReleases(releases);
---

{list.length === 0 ? (
  <div class="panel flex flex-col gap-5 p-7 sm:flex-row sm:p-10" data-releases-state="empty">
    <span class="inline-flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-surface-2 text-subtle">
      <CircleDashed size={22} aria-hidden="true" />
    </span>
    <div>
      <h2 class="t-3">{t.empty}</h2>
      <p class="mt-3 text-muted max-w-prose">{t.emptyBody}</p>
    </div>
  </div>
) : (
  <ol class="divide-y divide-[var(--border)] border-y border-line" data-releases-state="list">
    {list.map((r) => (
      <li class="flex flex-col gap-2 py-6 sm:flex-row sm:items-center sm:justify-between">
        <div>
          <h2 class="font-semibold text-lg">
            {r.name}
            {r.prerelease && <span class="pill pill-testing ml-2 align-middle">{t.prerelease}</span>}
          </h2>
          <p class="text-sm text-muted">
            {r.tag} · <time datetime={r.publishedAt}>{formatDate(r.publishedAt, locale)}</time>
          </p>
        </div>
        <a href={r.notesUrl} target="_blank" rel="noopener" class="link inline-flex items-center gap-1 text-sm">
          {all.download.notes}
          <ArrowUpRight size={14} aria-hidden="true" />
          <span class="sr-only">{all.a11y.newTab}</span>
        </a>
      </li>
    ))}
  </ol>
)}
