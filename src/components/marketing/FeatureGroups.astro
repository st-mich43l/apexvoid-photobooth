---
import Camera from "@lucide/astro/icons/camera";
import Sparkles from "@lucide/astro/icons/sparkles";
import Printer from "@lucide/astro/icons/printer";
import Folder from "@lucide/astro/icons/folder";
import ArrowRight from "@lucide/astro/icons/arrow-right";
import SectionHeading from "../common/SectionHeading.astro";
import { useDict, pathFor, type Locale } from "../../i18n";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useDict(locale).home.groups;
const icons = { capture: Camera, create: Sparkles, print: Printer, manage: Folder } as const;
---

<section class="section bg-elevated border-y border-line" aria-labelledby="groups-title">
  <div class="container-site">
    <div class="flex flex-col gap-6 md:flex-row md:items-end md:justify-between">
      <SectionHeading eyebrow={t.eyebrow} title={t.title} id="groups-title" />
      <a href={pathFor("features", locale)} class="link inline-flex items-center gap-2 font-medium shrink-0">
        {t.more}
        <ArrowRight size={16} aria-hidden="true" />
      </a>
    </div>
    <ul class="mt-14 grid gap-x-10 gap-y-12 sm:grid-cols-2 lg:grid-cols-4">
      {t.items.map((g) => {
        const Icon = icons[g.id as keyof typeof icons] ?? Sparkles;
        return (
          <li class="border-t border-line-strong pt-6">
            <span class="inline-flex h-11 w-11 items-center justify-center rounded-full bg-brand-soft text-accent">
              <Icon size={20} aria-hidden="true" />
            </span>
            <h3 class="t-3 mt-5">{g.title}</h3>
            <p class="mt-3 text-muted">{g.body}</p>
          </li>
        );
      })}
    </ul>
  </div>
</section>
