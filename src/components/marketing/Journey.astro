---
import SectionHeading from "../common/SectionHeading.astro";
import { useDict, type Locale } from "../../i18n";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useDict(locale).home.journey;
---

<section class="section" aria-labelledby="journey-title">
  <div class="container-site">
    <SectionHeading eyebrow={t.eyebrow} title={t.title} id="journey-title" />
    <ol class="journey mt-14 grid gap-0 md:grid-cols-3 lg:grid-cols-6">
      {t.steps.map((s, i) => (
        <li class="journey-step relative flex gap-5 pb-10 md:block md:pb-0 md:pr-6">
          <span class="step-num relative z-10 inline-flex h-11 w-11 shrink-0 items-center justify-center rounded-full border border-line-strong bg-bg font-display text-lg font-semibold">
            {i + 1}
          </span>
          <div class="md:mt-5">
            <h3 class="font-semibold text-[1.05rem] leading-snug">{s.title}</h3>
            <p class="mt-1.5 text-sm text-muted">{s.body}</p>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  /* the connecting line: vertical on phones, horizontal from tablet up */
  .journey-step::before {
    content: "";
    position: absolute;
    left: 1.375rem;
    top: 2.75rem;
    bottom: 0;
    width: 1px;
    background: var(--border-strong);
  }
  .journey-step:last-child::before {
    display: none;
  }
  @media (min-width: 48rem) {
    .journey {
      row-gap: 3rem;
    }
    .journey-step::before {
      left: 2.75rem;
      right: 0;
      top: 1.375rem;
      bottom: auto;
      width: auto;
      height: 1px;
    }
  }
  @media (min-width: 48rem) and (max-width: 63.99rem) {
    .journey-step:nth-child(3n)::before {
      display: none;
    }
  }
</style>
