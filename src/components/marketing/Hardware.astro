---
import Check from "@lucide/astro/icons/check";
import SectionHeading from "../common/SectionHeading.astro";
import { useDict, type Locale } from "../../i18n";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const all = useDict(locale);
const t = all.home.hardware;
---

<section class="section border-t border-line" aria-labelledby="hardware-title" id="hardware">
  <div class="container-site grid gap-14 lg:grid-cols-[minmax(0,0.85fr)_minmax(0,1.15fr)]">
    <div>
      <SectionHeading eyebrow={t.eyebrow} title={t.title} lede={t.lede} id="hardware-title" />
      <p class="mt-8 max-w-prose text-sm text-muted">{t.supportNote}</p>
    </div>
    <ul class="grid gap-4 sm:grid-cols-2">
      {t.rows.map((r) => (
        <li class="rounded-[var(--radius-md)] border border-line bg-surface p-5 sm:p-6">
          <div class="flex items-start gap-3">
            <span class="inline-flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-brand-soft text-accent">
              <Check size={18} aria-hidden="true" />
            </span>
            <div>
              <h3 class="font-semibold text-[1.05rem]">{r.name}</h3>
              <p class="mt-2 text-sm text-muted">{r.detail}</p>
            </div>
          </div>
        </li>
      ))}
    </ul>
  </div>
</section>
