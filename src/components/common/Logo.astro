---
/** The ApexVoid Photobooth mark: a photo strip in a rounded tile. Decorative; the wordmark carries the name. */
interface Props {
  size?: number;
  withWordmark?: boolean;
}
const { size = 32, withWordmark = true } = Astro.props;
const id = `lg${size}`;
---

<span class="inline-flex items-center gap-2.5">
  <svg width={size} height={size} viewBox="0 0 32 32" aria-hidden="true" focusable="false">
    <defs>
      <linearGradient id={id} x1="0" y1="0" x2="1" y2="1">
        <stop offset="0" stop-color="#8B5CF6"></stop>
        <stop offset="1" stop-color="#EC4899"></stop>
      </linearGradient>
    </defs>
    <rect width="32" height="32" rx="9" fill={`url(#${id})`}></rect>
    <rect x="10.5" y="5" width="11" height="22" rx="2.2" fill="#fff"></rect>
    <rect x="12.6" y="7.2" width="6.8" height="5" rx="1" fill="#2a1b45"></rect>
    <rect x="12.6" y="13.5" width="6.8" height="5" rx="1" fill="#2a1b45"></rect>
    <rect x="12.6" y="19.8" width="6.8" height="5" rx="1" fill="#2a1b45"></rect>
  </svg>
  {withWordmark && (
    <span class="font-semibold tracking-tight text-[1.02rem] leading-none whitespace-nowrap">
      ApexVoid <span class="font-normal text-muted">Photobooth</span>
    </span>
  )}
</span>
