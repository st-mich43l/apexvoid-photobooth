---
import SectionHeading from "../common/SectionHeading.astro";

interface Props {
  eyebrow: string;
  title: string;
  lede?: string | undefined;
}
const { eyebrow, title, lede } = Astro.props;
---

<section class="relative overflow-hidden border-b border-line">
  <div class="pointer-events-none absolute inset-x-0 -top-48 h-[30rem] opacity-70" style="background: var(--halo)" aria-hidden="true"></div>
  <div class="container-site relative pt-16 pb-14 sm:pt-24 sm:pb-20">
    <SectionHeading eyebrow={eyebrow} title={title} lede={lede} level="h1" />
  </div>
</section>
