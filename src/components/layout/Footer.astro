---
import Logo from "../common/Logo.astro";
import LanguageSwitch from "../navigation/LanguageSwitch.astro";
import { useDict, pathFor, type Locale } from "../../i18n";
import { REPO_URL } from "../../config/site";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useDict(locale);
const year = new Date().getUTCFullYear();
const cols = [
  {
    title: t.footer.product,
    links: [
      { href: pathFor("features", locale), label: t.nav.features },
      { href: pathFor("download", locale), label: t.nav.download },
      { href: pathFor("releases", locale), label: t.nav.releases },
    ],
  },
  {
    title: t.footer.project,
    links: [
      { href: pathFor("docs", locale), label: t.nav.docs },
      { href: pathFor("community", locale), label: t.nav.community },
      { href: REPO_URL, label: t.nav.github, external: true },
    ],
  },
];
const legalLinks = [
  { href: pathFor("privacy", locale), label: t.footer.privacy },
  { href: pathFor("licenses", locale), label: t.footer.licenses },
];
---

<footer class="border-t border-line bg-elevated">
  <div class="container-site py-6 pb-[calc(1.5rem+env(safe-area-inset-bottom))] lg:py-10 lg:pb-[calc(2.5rem+env(safe-area-inset-bottom))]">
    <div class="grid grid-cols-2 gap-x-6 gap-y-5 lg:grid-cols-[minmax(0,1.5fr)_repeat(3,minmax(0,1fr))] lg:gap-x-8 lg:gap-y-0">
      <div class="col-span-2 lg:col-span-1">
        <Logo />
        <p class="mt-2 max-w-xs text-sm leading-6 text-muted">{t.footer.blurb}</p>
      </div>

      <hr class="rule col-span-2 lg:hidden" />

      {cols.map((c) => (
        <nav aria-label={c.title}>
          <p class="text-sm font-semibold">{c.title}</p>
          <ul class="mt-2 space-y-0.5">
            {c.links.map((l) => (
              <li>
                <a
                  href={l.href}
                  class="inline-flex min-h-10 items-center text-sm text-muted no-underline hover:text-fg focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--accent)]"
                  {...("external" in l ? { target: "_blank", rel: "noopener" } : {})}
                >
                  {l.label}
                  {"external" in l && <span class="sr-only"> {t.a11y.newTab}</span>}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      ))}

      <nav aria-label={t.footer.legal} class="hidden lg:block">
        <p class="text-sm font-semibold">{t.footer.legal}</p>
        <ul class="mt-2 space-y-0.5">
          {legalLinks.map((l) => (
            <li>
              <a
                href={l.href}
                class="inline-flex min-h-10 items-center text-sm text-muted no-underline hover:text-fg focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--accent)]"
              >
                {l.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </div>

    <div class="mt-4 flex flex-wrap items-center justify-between gap-x-4 gap-y-2 lg:mt-6">
      <nav aria-label={t.footer.legal} class="lg:hidden">
        <ul class="flex flex-wrap items-center gap-x-4">
          {legalLinks.map((l) => (
            <li>
              <a
                href={l.href}
                class="inline-flex min-h-11 items-center text-sm text-muted underline-offset-4 hover:text-fg hover:underline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--accent)]"
              >
                {l.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>
      <LanguageSwitch locale={locale} size="lg" />
    </div>

    <hr class="rule mt-3 lg:mt-4" />
    <div class="mt-3 flex flex-col gap-1.5 text-xs leading-5 text-subtle sm:flex-row sm:justify-between sm:gap-4">
      <p>
        © {year} {t.footer.copyright}
      </p>
      <p>{t.footer.unofficial}</p>
    </div>
  </div>
</footer>
