---
import "../styles/global.css";
import Seo from "../components/layout/Seo.astro";
import Header from "../components/navigation/Header.astro";
import Footer from "../components/layout/Footer.astro";
import { THEME_BOOTSTRAP } from "../lib/client/theme";
import { localeNames, useDict, type Locale } from "../i18n";
// The hero heading is the largest paint on most pages: preload the display face's subsets for this language
// (the same hashed files the @font-face rules use) so it does not wait for the stylesheet to discover them.
import frauncesLatin from "@fontsource-variable/fraunces/files/fraunces-latin-wght-normal.woff2?url";
import frauncesLatinExt from "@fontsource-variable/fraunces/files/fraunces-latin-ext-wght-normal.woff2?url";
import frauncesVi from "@fontsource-variable/fraunces/files/fraunces-vietnamese-wght-normal.woff2?url";

interface Props {
  locale: Locale;
  title: string;
  description: string;
  jsonLd?: Record<string, unknown> | undefined;
  noindex?: boolean;
}
const { locale, title, description, jsonLd, noindex = false } = Astro.props;
const t = useDict(locale);
const preloads = locale === "vi" ? [frauncesLatin, frauncesVi, frauncesLatinExt] : [frauncesLatin];
---

<!doctype html>
<html lang={localeNames[locale].htmlLang} data-theme-pref="system">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#f7f6f3" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#09090f" />
    <script is:inline set:html={THEME_BOOTSTRAP} />
    {preloads.map((href) => (
      <link rel="preload" href={href} as="font" type="font/woff2" crossorigin />
    ))}
    <Seo title={title} description={description} locale={locale} jsonLd={jsonLd} noindex={noindex} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
  </head>
  <body class="flex min-h-dvh flex-col">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-3 focus:z-50 focus:rounded-full focus:bg-brand focus:px-5 focus:py-3 focus:text-white"
    >
      {t.a11y.skip}
    </a>
    <Header locale={locale} />
    <main id="main" class="flex-1" tabindex="-1">
      <slot />
    </main>
    <Footer locale={locale} />
    <script>
      import "../lib/client/ui";
    </script>
  </body>
</html>
