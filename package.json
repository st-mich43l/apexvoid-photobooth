{
  "name": "apexvoid-photobooth-webpage",
  "version": "0.1.0",
  "private": true,
  "description": "Public product website for ApexVoid Photobooth (photobooth.apexvoid.net). Static Astro site, independent of the desktop application.",
  "type": "module",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "check": "astro check && tsc --noEmit -p tsconfig.json",
    "lint": "prettier --check . && eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "build": "astro build && node scripts/check-links.mjs dist",
    "preview": "astro preview",
    "test:e2e": "playwright test",
    "links": "node scripts/check-links.mjs dist"
  },
  "dependencies": {
    "@astrojs/sitemap": "3.7.6",
    "@fontsource-variable/fraunces": "5.3.0",
    "@fontsource-variable/inter": "5.3.0",
    "@lucide/astro": "1.80.0",
    "@tailwindcss/vite": "4.3.5",
    "astro": "7.4.13",
    "tailwindcss": "4.3.5"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@axe-core/playwright": "4.14.1",
    "@playwright/test": "1.65.1",
    "@types/node": "22.20.7",
    "@typescript-eslint/parser": "8.74.0",
    "eslint": "10.15.0",
    "eslint-plugin-astro": "3.2.1",
    "prettier": "3.10.1",
    "prettier-plugin-astro": "1.1.2",
    "typescript": "6.0.3",
    "typescript-eslint": "8.74.0",
    "vitest": "5.1.1"
  }
}
